class Solution {
public:
    vector<int> limitOccurrences(vector<int>& arr, int k) {
        int n = arr.size();
        unordered_map<int,int> freq;
        vector<int> ans;

        for(int i=0;i<n;i++){
            if(freq[arr[i]]<k){
                ans.push_back(arr[i]);
                freq[arr[i]]++;
            }
        }
        return ans;
    }
};
