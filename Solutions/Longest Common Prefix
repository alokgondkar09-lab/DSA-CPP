class Solution {
public:
    string longestCommonPrefix(vector<string>& s) {
        sort(s.begin(),s.end());
        int n = s.size();
        string s1 = s[0];           
        string s2 = s[n-1]; 
        if(s1[0]!=s2[0]){      //if initaial chars are only diff stop there itself
            return {};
        }
        string ans;
        int i = 0 , j = 0;
        while( i<s1.size() && j<s2.size() ){
            if(s1[i]==s2[j]){
                ans.push_back(s1[i]);
                i++;
                j++;
            }
            if(s1[i]!=s2[j]){
                break;
            }
        }
        return ans;
    }
};
