class Solution {
public:
    string firstPalindrome(vector<string>& arr) {
        int n = arr.size();
        for(int i=0;i<n;i++){
            bool found = true;                //if string is already palindrome intially so why to name it fasle so keep it as true initally then if further conod is false make it false. 
            int k = 0;
            int j = arr[i].size() - 1;
            while(k<=j){
                if(arr[i][k]==arr[i][j]){
                    found = true;
                    k++;
                    j--;
                } 
                else{
                    found = false;
                    break;              //just use break not k++,j-- because once the first and last letter does not satisfy palindrome cond , even though inside characters satisfys still the str will be palindrome.
                }
            }
            if(found==true){
                return arr[i];
            }
        }
        return{};
    }
};


