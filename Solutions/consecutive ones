class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& arr) {
        int n = arr.size();
        int maxi = 0;
        int count = 0;
        for(int i=0;i<n;i++){
            if(arr[i]==1){
                count++;
                maxi =  max(maxi,count);
            }
            if(arr[i]==0){
                count = 0; //otherwise count keeps always ++ bcz there is no cond to break it when o occurs
            }
        }
        return maxi;
    }
};
