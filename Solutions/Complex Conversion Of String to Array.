class Solution {
public:
    int lengthOfLastWord(string s) {
        int n = s.size();
        vector<string> ans;
        string words = "";
        for(int i=0;i<n;i++){
            if(s[i]==' '){
                if(words!=""){   //to avoid condition where we have empty str at starting only.(this means if words is not empty string then only push back)
                    ans.push_back(words);
                     words = "";
                }
            }
            else{
                words+=s[i];
            }
        }
        if(!words.empty()){
            ans.push_back(words);  //if "hello  " then we are pushing empty string , so use when words is not empty then only oush back.
        }
        
        int a = ans.size();
        return ans[a-1].size();
    }
};


MY METHOD 

class Solution {
public:
    int lengthOfLastWord(string s) {
        int n = s.size();
        int count = 0;
        for(int i=n-1;i>=0;i--){
            if(s[i]==' ' && count==0){           //to skip condition where the initial char is itself empty string.
                continue;
            }
            if(s[i]!=' '){
                count++;
            }
            else{                                // when s[i]==' ' , but not when count is zero.
                return count;
            }
        }
        return count;                //dont type return{} , because this(return count) handles case where string contains only one word.
    }
}; 
