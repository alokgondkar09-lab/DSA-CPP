class Solution {
public:
    int reverse(int x) {
        int ans = 0;
        int rem = 0;
        while(x!=0){
            rem = x%10;
            x /= 10;
            if(ans>INT_MAX/10 || ans<INT_MIN/10){ //to overcome overflow
                return 0;
            }
            ans = ans*10 + rem;
        }
        return ans;
    }
};

// ans*10 + rem >INT_MAX
// ans > (INT_MAX - rem) /10
// ans > INT_MAX /10 ---> rem/10 ~ 0 (rem always bte 0-9) 
