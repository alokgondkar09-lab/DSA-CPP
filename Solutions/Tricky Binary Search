class Solution {
public:
    char nextGreatestLetter(vector<char>& arr, char tar) {
        int n = arr.size();
        int lo = 0;
        int hi = n - 1;

        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;

            if (arr[mid] <= tar) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }

        if (lo == n) {
            return arr[0];
        }

        return arr[lo];
    }
};
