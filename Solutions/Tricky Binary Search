class Solution {
public:
    char nextGreatestLetter(vector<char>& arr, char tar) {
        int n = arr.size();
        int lo = 0;
        int hi = n - 1;
        while(lo<=hi){
            int mid = lo + (hi-lo)/2;
            if(arr[mid]<tar){
                lo = mid + 1;
            }
            else if(arr[mid]>tar){
                hi = mid-1; //special casw here.(my approach was wrong)
            }
            else if(arr[mid]==tar){
                lo=mid+1; //see ex2 if should not return sam tar as answer.
            }
        }
        if(lo==n){
            return arr[0];  //it means non of ele insude array is greater than tar.
        }
        return arr[lo];
    }
};

