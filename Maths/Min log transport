We use it to prevent integer overflow when multiplying large numbers.
1 → int (usually 32-bit)
1LL → long long (usually 64-bit)


class Solution {
public:
    long long minCuttingCost(int n, int m, int k) {
        long long cost = 0;
        if(n>k){
           cost = 1LL*k*(n-k);
        }
        if(m>k){
           cost = 1LL*k*(m-k);
        }
        if(m>k && n>k){
            cost = 1LL*k*(n-k) + 1LL*k*(m-k) ;
        }
        if(n<k && m<k){
            return 0;
        }
        return cost;
    }
};
