class Solution {
public:
    int minLength(string s) {
        int n = s.size();
        stack<char> st;
        for(int i=0;i<n;i++){
            if(st.empty()) st.push(s[i]);
            else if(st.top()=='A' and s[i]=='B'){
                st.pop();
            }
            else if(st.top()=='C' and s[i]=='D'){
                st.pop();
            }
            else st.push(s[i]);
        }
        string t = "";
        while(!st.empty()){
            t+=st.top();
            st.pop();
        }
        int a = t.size();
        return a;
    }
};
