class Solution {
  public:
    vector<int> makeBeautiful(vector<int> arr) {
        int n = arr.size();
        stack<int> st;
        for(int i=0;i<n;i++){
            if(st.empty()){         //if initially empty just push 
                st.push(arr[i]);
            }
            else if(arr[i]>=0){            //pushing ele is pos
                if(st.top()>=0){
                    st.push(arr[i]);
                }
                else{
                    st.pop();
                }
            }
            else{                          //when pushing ele(arr[i]) is neg
                if(st.top()<0){
                    st.push(arr[i]);
                }
                else{
                    st.pop();
                }
            }

        }
        vector<int> ans;
        while(!st.empty()){
            ans.push_back(st.top());
            st.pop();
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
};
