class Solution {
public:
    ListNode *getIntersectionNode(ListNode *head1, ListNode *head2) {
        ListNode* t1 = head1;
        ListNode* t2 = head2;
        int l1 = 0 , l2 = 0;
        while(t1!=NULL){
            l1++;
            t1 = t1->next;
        }
        while(t2!=NULL){
            l2++;
            t2 = t2->next;
        }
        t1 = head1;
        t2 = head2;

        if(l1>l2){
            for(int i=1;i<=(l1-l2);i++){
                t1 = t1->next;
            }
        }
        else{
            for(int i=1;i<=(l2-l1);i++){
                t2 = t2->next;
            }
        }
        while(t1!=NULL && t2!=NULL){
            if(t1==t2){
                return t1;
            }
            t1 = t1->next;
            t2 = t2->next;
        }
        return{};
    }
};
