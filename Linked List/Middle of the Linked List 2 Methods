class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        int len = 0;
        ListNode* temp = head;
        while(temp!=NULL){
            len++;
            temp = temp->next;
        }
        temp = head;   //reset temp to heads place
        for(int i=1;i<=(len/2);i++){
            temp = temp->next;
        }
        return temp;
    }
};


METHOD-2

class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        ListNode* slow = head;
        ListNode* fast = head;
        while( fast!=NULL && fast->next!=NULL ){            //here always first write only fast condn then fast next cond  because if fast is already NULL then accessing fast->next give runtime error
            slow = slow->next;                   //slow ko ek baar aage badado
            fast = fast->next->next;             //fast ko do baar
        }
        return slow;
    }
};
