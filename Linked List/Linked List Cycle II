class Solution {
public:
    ListNode *detectCycle(ListNode *head) {
        ListNode* slow = head;
        ListNode* fast = head;
        while(fast!=NULL && fast->next!=NULL){
            slow = slow->next;
            fast = fast->next->next; 
            if(fast==slow) break;
        }

        if(fast==NULL || fast->next==NULL) return NULL;          //IMP 

        ListNode* temp = head;
        while(slow!=temp){
            temp = temp->next;
            slow = slow->next; 
        }
        return slow;
    }
};
