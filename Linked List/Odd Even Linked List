class Solution {
public:
    ListNode* oddEvenList(ListNode* head) {
        ListNode* d1 = new ListNode(-1);
        ListNode* d2 = new ListNode(-1);
        ListNode* t1 = d1;
        ListNode* t2 = d2;
        ListNode* temp = head;
        int idx = 1;  //given first node is odd(cant keep 0 as idx) and second is even(cant keep 1 as idx)
        while(temp!=NULL){
            if( idx%2!=0 ){
                t1->next = temp;
                t1 = t1->next;
            }
            else{
                t2->next = temp;
                t2 = t2->next;
            }
            temp = temp->next;
            idx++;
        }
        t1->next = NULL;
        t2->next = NULL;
        t1->next = d2->next;
        return d1->next;
    }
};
