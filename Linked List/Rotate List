class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if(head==NULL || head->next==NULL) return head;
        ListNode* temp = head;
        int n = 0;
        while(temp!=NULL){
            n++;
            temp = temp->next;
        }
      
>>      if(k>=n){
            k = k%n;
        }
>>      if(k==0) return head;
      
        ListNode* a = head;
        for(int i=1;i<=(n-k-1);i++){
            a = a->next;
        }
        // ListNode* b = a->next;  this is also correct
        ListNode* tail = head;
        while(tail->next!=NULL){
            tail = tail->next;
        }
        ListNode* b = head;
        for(int i=1;i<=(n-k);i++){
            b = b->next;
        }
        a->next = NULL;
        tail->next = head;
        return b;     //it doesnt return node next to b , it returns list starting from b.
    }
};



