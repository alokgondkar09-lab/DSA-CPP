class Solution {
public:
    ListNode* partition(ListNode* head, int x) {
        ListNode* d1 = new ListNode(-1);
        ListNode* d2 = new ListNode(-1);
        ListNode* i = d1;
        ListNode* j = d2;
        ListNode* temp = head;
        while(temp!=NULL){
            ListNode* a = temp->next;
            if(temp->val < x){
                i->next = temp;
                i = i->next;
                i->next = NULL;
            }
            temp = a;
        }
        temp = head;
        while(temp!=NULL){
            ListNode* a = temp->next;
            if(temp->val >= x){
                j->next = temp;
                j = j->next;
                j->next = NULL;
            }
            temp = a;
        }
        j = d2->next;
        i->next = j;
        return d1->next;
    }
};

class Solution {
public:
    ListNode* partition(ListNode* head, int x) {
        ListNode* d1 = new ListNode(-1);
        ListNode* d2 = new ListNode(-1);
        ListNode* t1 = d1;
        ListNode* t2 = d2;
        ListNode* temp = head;
        while(temp!=NULL){
            if(temp->val < x){
                t1->next = temp;
                t1 = t1->next;
            }
            else{
                t2->next = temp;
                t2 = t2->next;
            }
            temp = temp->next;
        }
        t1->next = NULL;
        t2->next = NULL;
        t1->next = d2->next;
        return d1->next;
    }
};
