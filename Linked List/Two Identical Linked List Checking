class Solution {
  public:
    bool areIdentical(Node *head1, Node *head2) {
        Node* t1 = head1;
        Node* t2 = head2;
        int l1 = 0 , l2 = 0;
        while(t1!=NULL){
            l1++;
            t1 = t1->next;
        }
        while(t2!=NULL){
            l2++;
            t2 = t2->next;
        }
        if(l1!=l2){
            return false;
        }
        t1 = head1;        //RESET BOTH TO HEAD AFTER CALULATING LENGHT.
        t2 = head2;
        bool found = true;
        while(t1!=NULL && t2!=NULL){
            if(t1->data != t2->data){
                found = false;
                break;
            }
            t1 = t1->next;
            t2 = t2->next;
        }
        if(found==false){
            return false;
        }
        else{
            return true;
        }
        return{};
    }
};
