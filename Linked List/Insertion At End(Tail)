class Solution {
public:
    void insert(Node* temp, int x) {
        Node* n = new Node(x);
        temp->next = n;
    }

    Node* insertAtEnd(Node* head, int x) {
        if(head == NULL) {
            return new Node(x);
        }

        Node* temp = head;

        while(temp->next != NULL) {
            temp = temp->next;
        }

        insert(temp, x);

        return head;
    }
};
