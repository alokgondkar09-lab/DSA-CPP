class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        ListNode* i = list1;
        ListNode* dummy = new ListNode(-1);
        ListNode* j = list2;
        ListNode* k = dummy;
        while(j!=NULL && i!=NULL){
            if(i->val <= j->val){
                k->next = i;
                i = i->next;
                k = k->next;
            }
            else{                        //use else instead of if() bcz if considers new value.
                k->next = j;
                j = j->next;
                k = k->next;
            }
        }
        if(j==NULL){
            k->next = i;
        }
        if(i==NULL){
            k->next = j;
        }
        return dummy->next;
    }
};
