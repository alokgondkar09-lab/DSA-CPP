class Solution {
public:
    ListNode* reverse(ListNode* head) {
        ListNode* curr = head;
        ListNode* prev = NULL;
        while(curr!=NULL){
            ListNode* fwd = curr->next;
            curr->next = prev;
            prev = curr;
            curr = fwd;
        }
        return prev;
    }
    void reorderList(ListNode* head) {
        ListNode* slow = head;
        ListNode* fast = head;
        while( fast->next!=NULL && fast->next->next!=NULL ){
            slow = slow->next;
            fast = fast->next->next;
        }
        ListNode* b = slow->next;
        slow->next = NULL;

        b = reverse(b);
        ListNode* d = new ListNode(-1);
        ListNode* k = d;
        ListNode* i = head;
        ListNode* j = b;
        while(i!=NULL && j!=NULL){                                                                   
            k->next = i;
            i = i->next;            //Save Access to next node                 
            k = k->next;

            k->next = j;
            j = j->next;
            k = k->next;
        }
        if(j==NULL) k->next = i;
        else k->next = j;
    }
};


