class Solution {
public:
    ListNode* reverse(ListNode* head){
        ListNode* prev = NULL;
        ListNode* curr = head;
        while(curr!=NULL){
            ListNode* fwd = curr->next;
            curr->next = prev;
            prev = curr;
            curr = fwd;
        }
        return prev;
    }
    bool isPalindrome(ListNode* head) {
        //reach the left middle (even)
        ListNode* slow = head;
        ListNode* fast = head;
        while(fast->next!=NULL && fast->next->next!=NULL){
            slow = slow->next;
            fast = fast->next->next;
        }
        ListNode* a = head;
        ListNode* b = slow->next;                                                             //slow is the middle node and name b for its next node
        slow->next = NULL;
        b = reverse(b);

        ListNode* t1 = a;
        ListNode* t2 = b;
        while(t2!=NULL){
            if(t1->val != t2->val) return false;
            t1 = t1->next;
            t2 = t2->next;
        }
        slow->next = reverse(b);                                                            //to maintain the original list.
        return true;
    }
};
