class Solution {
public:
    int searchInsert(vector<int>& arr, int tar) {
        int n = arr.size();
        for(int i=0;i<n;i++){
            if(arr[i]==tar) return {i};
        }
        int lo = 0 , hi = n-1;
        while(lo<=hi){
            int mid = lo + (hi-lo)/2;
            if(arr[mid]>tar) hi = mid - 1;
            if(arr[mid]<tar) lo = mid + 1;
        }
        return lo;
    }
};
