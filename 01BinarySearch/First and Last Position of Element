class Solution {
public:
    vector<int> searchRange(vector<int>& arr, int tar) {
        int n = arr.size();

        int first = -1;
        int last = -1;

        // Find first occurrence
        int lo = 0;
        int hi = n - 1;

        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;

            if (arr[mid] == tar) {
                first = mid;
                hi = mid - 1;
            }
            else if (arr[mid] < tar) {
                lo = mid + 1;
            }
            else {
                hi = mid - 1;
            }
        }

        // Find last occurrence
        lo = 0;
        hi = n - 1;

        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;

            if (arr[mid] == tar) {
                last = mid;
                lo = mid + 1;
            }
            else if (arr[mid] < tar) {
                lo = mid + 1;
            }
            else {
                hi = mid - 1;
            }
        }

        return {first, last};
    }
};
