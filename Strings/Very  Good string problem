class Solution {
public:
    string interpret(string c) {
        string s;
        int n = c.size();

        for(int i=0; i<n; i++) {
            if(c[i] == 'G') {
                s.push_back('G');
            }
            else if(c[i] == '(' && c[i+1] == ')') {
                s.push_back('o');
                i++;                                              //IMP
            }
            else if(c[i] == '(') {
                s += "al";                                     -->>> s.push_back() only accepts single char[here ' '] , so to push two char we use += [but here use " "] [not' '] 
                i += 3;                                        //IMP (other wise it check next i so increament
            }
        }
        return s;
    }
};
