class Solution {
public:
    int percentageLetter(string s, char letter) {
        int n = s.size();
        int count = 0;
        for(int i=0;i<n;i++){
            if(s[i]==letter){
                count += 1;
            }
        }
        int per = (count*100)/n;        //int per = (count / n) * 100; is wrong-- 2/6*100 = 0.33*100 = 0*100 in cpp
        return per;
    }
};
