class Solution {
public:
    string mergeAlternately(string w, string v) {
        int n = w.size();
        int m = v.size();
        int i = 0;
        int j = 0;
        string s;
        while(i<n && j<m){
            s.push_back(w[i]);
            s.push_back(v[j]);
            i++;
            j++;
        }

        //push extra elements when both str are unequal 
        // i,j starts from where it ended in previous loop ,it does not starts from 0.
         
        while(j<m){
            s.push_back(v[j]);
            j++;
        } 
        while(i<n){
            s.push_back(w[i]);
            i++;
        } 
        return s;
    }
};
