class Solution {
public:
    string mergeAlternately(string w, string v) {
        int n = w.size();
        int m = v.size();
        int i = 0;
        int j = 0;
        string s;
        while(i<n && j<m){
            s.push_back(w[i]);
            s.push_back(v[j]);
            i++;
            j++;
        }

        //push extra elements when both str are unequal 
        // i,j starts from where it ended in previous loop ,it does not starts from 0.
         
        while(j<m){
            s.push_back(v[j]);
            j++;
        } 
        while(i<n){
            s.push_back(w[i]);
            i++;
        } 
        return s;
    }
};


METHOD 2(USING 1LOOP ONLY)

class Solution {
public:
    string mergeAlternately(string w, string v) {
        string s;
        int n = w.size(), m = v.size();

        for (int i = 0; i < max(n, m); i++) {
            if (i < n) s.push_back(w[i]);
            if (i < m) s.push_back(v[i]);
        }

        return s;
    }
};

METHOD 3(concatenation)

class Solution {
public:
    string mergeAlternately(string w, string v) {
        string ans;
        int n = w.size(), m = v.size();

        for (int i = 0; i < n || i < m; i++) {
            if (i < n) ans += w[i];
            if (i < m) ans += v[i];
        }

        return ans;
    }
};
