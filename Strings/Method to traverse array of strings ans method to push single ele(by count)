class Solution {
public:
    vector<int> findWordsContaining(vector<string>& arr, char x) {
        int n = arr.size();
        vector<int> ans;
        for(int i=0;i<n;i++){
            int count = 0;                                   //RESET TO 0
            for(int j=0;j<arr[i].size();j++){
                if(arr[i][j]==x){
                    count++;
                    if(count==1){                        //IF THERE ARE TWO CHAR SATISFYING COND THIS IS THE METHID TO PUSH ONLY INDEX 1 TIME.
                        ans.push_back(i);
                    } 
                }
            }
        }
        return ans;
    }
};
