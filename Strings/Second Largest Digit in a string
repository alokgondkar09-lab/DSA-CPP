class Solution {
public:
    int secondHighest(string s) {
        int n = s.size();
        vector<int> ans;
        for(int i=0;i<n;i++){
            if(s[i]>='0' && s[i]<='9'){
                ans.push_back(s[i]-'0');     //it pushes 5 instead of '5' .
            }
        }
        
        set<int> st(ans.begin(),ans.end());
        if(st.size()==1){
            return -1;
        }
        
        int a = ans.size();
>>        if(a==0){
            return -1;                       //EDGE CASE(hidden)
  >>      }
        int maxi = 0;
        for(int i=0;i<a;i++){
            if(ans[i]>maxi){
                maxi = ans[i];
            }
        }
        int smaxi = 0;
        for(int i=0;i<a;i++){
            if(ans[i]>smaxi && ans[i]<maxi){
                smaxi = ans[i];
            }
        }
        return smaxi;
    }
};
