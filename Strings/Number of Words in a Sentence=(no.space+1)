class Solution {
public:
    int mostWordsFound(vector<string>& s) {
        int n = s.size();
        int words = 1;
        int maxi = 0;
        for(int i=0;i<n;i++){
            words = 1;                                             //RESET
            for(int j=0;j<s[i].size();j++){
                if(s[i][j]==' '){
                    words++;
                }
            }
            maxi = max(maxi,words);                              //updating maxi and considering max value of each trial.
        }
        return maxi;
    }
};
