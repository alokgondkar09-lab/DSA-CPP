class Solution {
public:
    vector<int> sortArrayByParityII(vector<int>& arr) {
        int n = arr.size();
        vector<int> ans(n);
        int p = 0;
        int q = 1;
        int i = 0;
        while(i<n){
            if(arr[i]%2==0){
                ans[p]=arr[i];
                p+=2;
                i++;
            }
            else if(arr[i]%2==1){
                ans[q]=arr[i];
                q+=2;
                i++;
            }
        }
        return ans;
    }
};
