class Solution {
public:
    void rotate(vector<int>& arr, int k) {
        int n = arr.size();
        if(n==0){
            return;  //JUST RETURN ONLY , NO RETURN ARR[0] BECAUSE WE HAVE VOID FUNCTION
        }

        k = k%n; //k can be greater than n(SPECIALCASE)

        reverse(arr.begin(),arr.end());

        int i = 0 , j = k - 1 ;
        while(i<=j){
            swap(arr[i],arr[j]);
            i++;
            j--;
        }
        int l = k , m = n - 1 ;
        while(l<=m){
            swap(arr[l],arr[m]);
            l++;
            m--;
        }
    }
};
