class Solution {
public:
    int differenceOfSum(vector<int>& arr) {
        int n = arr.size();
        int sum = 0;
 -->>NORMAL SUM       for(int i=0;i<n;i++){
            sum+=arr[i];
        }

        int sum1 = 0;
       for(int i=0;i<n;i++){                         -->>DIGIT SUM METHOD 
            string s = to_string(arr[i]);             EX:-  nums = [1,15,6,3]   , The digit sum of nums is 1 + 1 + 5 + 6 + 3 = 16.  (convert each element to string and calculate sum of string elements[dont forget -'0]
            for(int j=0;j<s.size();j++){
                sum1+=(s[j]-'0');       --->>   [ '5'(str)-'0' = 5(int)]
            }
        }
        return abs(sum-sum1);
    }
};
