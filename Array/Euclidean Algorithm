class Solution {
public:
    int findGCD(vector<int>& arr) {
        int n = arr.size();
        int max = 0;
        int min = arr[0];
        for(int i=0;i<n;i++){
            if(arr[i]>max){
                max = arr[i];
            }
            if(arr[i]<min){
                min = arr[i];
            }
        }
        while(min != 0) {
            int remainder = max % min;
            max = min;
            min = remainder;
        }
        return max;
    }
};
