class Solution {
public:
    bool isConsecutive(vector<int>& arr) {
        int n = arr.size();
        int max = 0;
        int min = arr[0];
        for(int i=0;i<n;i++){
            if(arr[i]>max){
                max = arr[i];
            }
        }
        for(int i=1;i<n;i++){
            if(arr[i]<min){
                min = arr[i];
            }
        }
        if( max - min + 1 != n ){
            return false;
        }
        else{
            return true;
        }
    }
};
