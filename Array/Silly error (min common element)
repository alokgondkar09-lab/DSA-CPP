class Solution {
public:
    int getCommon(vector<int>& arr1, vector<int>& arr2) {
        int n = arr1.size();
        int m = arr2.size();
        int i = 0;
        int j = 0;
        while(i<n && j<m){
            if(arr1[i]==arr2[j]){
                return arr1[i];
            }
            else if(arr1[i]<arr2[j]) {
                i++;
            }
            else{
                j++;
            }
        }
        return -1;
    }
};



//Why else if?
At every step, only one thing should happen:
arr1[i] == arr2[j] → found → return
arr1[i] < arr2[j] → move i
arr1[i] > arr2[j] → move j
