class Solution {
  public:
    void sort012(vector<int>& arr) {
        int n = arr.size();
        int c = 0 , c1 = 0 , c2 = 0;
        for(int i=0;i<n;i++){
            if(arr[i]==0) c++;
            if(arr[i]==1) c1++;
            if(arr[i]==2) c2++;
        }
        
        for(int i=0;i<c;i++){
            arr[i] = 0;
        }
        for(int i=c;i<c1+c;i++){
            arr[i] = 1;
        }
        for(int i=c1+c;i<c2+c1+c;i++){
            arr[i] = 2;
        }
    }
};
