class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        vector<int> p;
        vector<int> ne;
        for(int i=0;i<n;i++){
            if(nums[i]>=0){
                p.push_back(nums[i]);
            }
        }
        for(int i=0;i<n;i++){
            if(nums[i]<0){
                ne.push_back(nums[i]);
            }
        }
        int i = 0;
        int j = 0;
        int a = p.size();
        int b = ne.size();
        vector<int> ans;
        while(i<a && j<b){
            ans.push_back(p[i]);
            ans.push_back(ne[j]);
            i++;
            j++;
        }
        return ans;
    }
};

