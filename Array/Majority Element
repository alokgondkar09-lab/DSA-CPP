class Solution {
public:
    int majorityElement(vector<int>& arr) {
        int n = arr.size();

        //sort
        sort(arr.begin() , arr.end());

        //freq count
        int freq = 1;
        int ans = arr[0];  //assuming both freq and ans are 1st term

        for(int i=1;i<n;i++){
            if(arr[i] == arr[i-1]){
                freq++;
            }
            else{  //just not equal case
                freq = 1;  //resetting
                ans = arr[i];
            }
            if(freq>n/2){
                return ans;
            }
        }
        return ans;
    }
};
