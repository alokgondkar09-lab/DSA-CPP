class Solution {
public:
    int earliestTime(vector<vector<int>>& tasks) {
        int ans = INT_MAX;  or int ans = 200;

        for (int i = 0; i < tasks.size(); i++) {
            int finish = tasks[i][0] + tasks[i][1];

            if (finish < ans) {
                ans = finish;
            }
        }

        return ans;
    }
};
