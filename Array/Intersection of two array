class Solution {
public:
    vector<int> intersection(vector<int>& arr1, vector<int>& arr2) {
        int n = arr1.size();
        int m = arr2.size();
        vector<int> ans;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if( arr1[i] == arr2[j] ){
                    if(find(ans.begin(), ans.end(), arr1[i]) == ans.end()){
                        ans.push_back(arr1[i]);
                    }
                }
            }
        }
        return ans;
    }
};

