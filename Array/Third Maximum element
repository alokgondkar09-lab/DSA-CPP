class Solution {
public:
    int thirdMax(vector<int>& arr) {
        int n = arr.size();
        int count = 0 ;
        sort(arr.begin(),arr.end());

        for(int i=n-1;i>=0;i--){
            if(i==0 ||arr[i] != arr[i-1]){
                count++;
            }
            if(count == 3){
                return arr[i];
            }
        }
        if(n<3){
            return arr[n-1];
        }
        return arr[n-1];
    }
};
