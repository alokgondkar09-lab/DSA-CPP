class Solution {
public:
    vector<int> findDuplicates(vector<int>& arr) {
        int n = arr.size();
        vector<int> ans;
        // int Freq[n+1] = {0};
        vector<int> Freq(n+1, 0);            //bcz we dont know exact ans array size.
        for(int i=0;i<n;i++){
            Freq[arr[i]]++;
            if(Freq[arr[i]]==2){
                ans.push_back(arr[i]);
            }
        }
        return ans;
    }
};
