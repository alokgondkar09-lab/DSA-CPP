class Solution {
public:
    double findMedianSortedArrays(vector<int>& arr1, vector<int>& arr2) {
        vector<int> ans;
        int n = arr1.size();
        int m = arr2.size();
        int i=0,j=0;
        // int med = 0;
        while(i<n && j<m){
            if(arr1[i]<arr2[j]){
                ans.push_back(arr1[i]);
                i++;
            }
            else{  // else handles case where both are equal instead of if
                ans.push_back(arr2[j]);
                 j++;
            }
        }
        while(i < n){ //if a element is left inside(adding individual)
            ans.push_back(arr1[i]);
            i++;
        }

        while(j < m){  //if a element is left inside
            ans.push_back(arr2[j]);
            j++;
        }

        int a =ans.size();

        if(ans.size()%2!=0){
            return ans[(a-1)/2];   // use directly return to get double value , if we use int med; then return then we get 2 nor 2.5.
        }

        if(ans.size()%2==0){
            return (ans[ a/2 ] + ans[ a/2 -1 ]) / 2.0 ;
        }
        return{};
    }
};
