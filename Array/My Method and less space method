class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& arr) {
        int i = 0;
        int j = arr.size() - 1;

        while (i < j) {
            if (arr[i] % 2 == 0) {
                i++;
            }
            else if (arr[j] % 2 == 1) {
                j--;
            }
            else { //when arr[i] is odd and arr[j] is even.
                swap(arr[i], arr[j]); //now even comes at left and odd goes to right as per required condition.
                i++;
                j--;
            }
        }

        return arr;
    }
};
