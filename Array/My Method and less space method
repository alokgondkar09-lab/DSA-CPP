class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& arr) {
        int n = arr.size();
        vector<int> ans(n);
        int i = 0;
        int p = 0;
        int q = n - 1;
        while(i<n){
            if(arr[i]%2==0){
                ans[p]=arr[i];
                i++;
                p++;
            }
            else if(arr[i]%2==1){
                ans[q]=arr[i];
                i++;
                q--;
            }
        }
        return ans;
    }
};  

