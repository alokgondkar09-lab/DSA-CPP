class Solution {
public:
    int missingNumber(vector<int>& arr) {
        int n = arr.size();
        sort(arr.begin(),arr.end());
        if(n==0) return 0;
        if(arr[0]==0 && arr.size()==1) return 1;
        if(arr[0]!= 0) return 0;
        if(arr[n-1] != n) return n;
        for(int i=0;i<n-1;i++){
            if(arr[i+1] != arr[i]+1){
                return {arr[i+1]-1};
            }   
        }
        return{};
    }
};
